# 本地开发 / Docker Compose 通用环境变量
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# development | production
APP_ENV=development
PORT=5001

# 外部 Embedding API（OpenAI-compatible）
# 推荐 SiliconFlow：https://api.siliconflow.cn/v1
# 不配置 EMBEDDING_API_KEY 时使用轻量关键词检索兜底，不加载本地模型。
EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
# 也可使用 SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=60

# 本地默认项目目录；Docker Compose 中固定为 /data
# APS_DATA_DIR=

# 检索参数
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_RELEVANCE_SCORE=0.50

# 上传限制
MAX_UPLOAD_MB=20
