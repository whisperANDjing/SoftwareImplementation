# 本地开发 / Docker Compose 通用环境变量
# 不配置 DEEPSEEK_API_KEY 时使用本地演示兜底。
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# development | production
APP_ENV=development
PORT=5001

# 嵌入模型与缓存
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
HF_ENDPOINT=https://hf-mirror.com
# 默认使用 <项目>/storage/hf-cache；如需覆盖可取消注释
# HF_HOME=

# 本地默认项目目录；Docker Compose 中固定为 /data
# APS_DATA_DIR=

# 检索参数
RAG_TOP_K=5
RAG_MIN_SCORE=0.35
RAG_RELEVANCE_SCORE=0.50

# 上传限制
MAX_UPLOAD_MB=20
